if TARGET_LOWRISC_MOCHA

config SYS_BOARD
	default "mocha"

config SYS_VENDOR
	default "lowrisc"

config SYS_CPU
	default "generic"

config SYS_CONFIG_NAME
	default "lowrisc-mocha"

config TEXT_BASE
	default 0x80000000 if TARGET_LOWRISC_MOCHA && !RISCV_SMODE
	default 0x80200000 if TARGET_LOWRISC_MOCHA && RISCV_SMODE

config BOARD_SPECIFIC_OPTIONS
	def_bool y
	select GENERIC_RISCV
	imply SERIAL
	imply GPIO
	imply SPI
	imply LOWRISC_ETH
	imply LOWRISC_OPENTITAN_UART
	imply LOWRISC_OPENTITAN_GPIO
	imply LOWRISC_OPENTITAN_SPI_HOST

endif
